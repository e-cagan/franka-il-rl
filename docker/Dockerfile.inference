# Inference image: ROS2 Humble + PyTorch + MuJoCo.
#
# Base `ros:humble` is Ubuntu 22.04 with Python 3.10 fixed. This is the
# whole point of containerizing inference: it eliminates the host venv
# (Python 3.12) vs ROS2 (Python 3.10) ABI conflict that caused the
# numpy C-extension import failures during bare-metal dev.
FROM ros:humble

ENV DEBIAN_FRONTEND=noninteractive
ENV MUJOCO_GL=egl
ENV PYTHONUNBUFFERED=1

# System libs: pip, colcon, MuJoCo headless rendering, HDF5
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip \
        python3-colcon-common-extensions \
        libgl1 \
        libegl1 \
        libosmesa6 \
        libglfw3 \
        libhdf5-dev \
    && rm -rf /var/lib/apt/lists/*

# PyTorch with CUDA 12.1. The wheel bundles its own CUDA runtime, so the
# container needs only the host driver + nvidia container runtime — no
# system CUDA install required. Use `device:=cpu` at launch to skip GPU.
RUN pip3 install --no-cache-dir \
        torch==2.5.1 --index-url https://download.pytorch.org/whl/cu121

# Remaining Python deps. numpy pinned to match the training image so
# checkpoints load with identical numeric behavior.
RUN pip3 install --no-cache-dir \
        "numpy==1.26.4" \
        "gymnasium>=0.29" \
        "gymnasium-robotics>=1.3.0" \
        "mujoco>=3.1" \
        "h5py" \
        "pyyaml"

WORKDIR /workspace

COPY docker/entrypoint_inference.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
# Default runs the full pipeline with the BC baseline. Override
# checkpoint / backend / device by appending launch args.
CMD ["ros2", "launch", "policy_runner", "full_pipeline.launch.py", \
     "checkpoint:=/workspace/data/checkpoints/bc/bc_seed42/last.pt"]